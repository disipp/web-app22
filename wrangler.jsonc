{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app22",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "9ba3a530-d892-489f-9114-95d24bd67c05","database_name": "web-app22" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "22b39890e5e8431793729fe3bc16ee96" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
